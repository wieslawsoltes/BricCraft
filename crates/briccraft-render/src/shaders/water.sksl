// Mapped rivers and lakes are actual brick geometry. A negative level disables
// the island's decorative ocean instead of placing another infinite plane
// beneath the mapped terrain. Zero remains a valid enabled sea level.
float waterSurfaceDistance(float3 origin,float3 ray) {
    if(sun_direction.w<0.0 || abs(ray.y)<=0.000001) return FAR;
    float distance=(sun_direction.w-origin.y)/ray.y;
    return distance>0.0?distance:FAR;
}

float3 waterColor(float3 position,float3 ray,float distance) {
    float time=camera_position.w;
    float2 uv=position.xz;
    float2 width=surfaceFootprint(distance,ray,float3(0.0,1.0,0.0),0.0).xz;
    float2 frequency1=float2(0.46,0.29),frequency2=float2(0.19,-0.48);
    float wave1=filteredSine(dot(uv,frequency1)+time*1.3,dot(width,abs(frequency1)));
    float wave2=filteredSine(dot(uv,frequency2)-time*0.8,dot(width,abs(frequency2)));
    float3 normal=normalize(float3(wave1*0.055,1.0,wave2*0.055));
    float fresnel=0.12+0.68*pow(1.0-max(dot(-ray,normal),0.0),4.0);
    float3 color=mix(float3(0.035,0.47,0.58),skyEnvironment(reflect(ray,normal)),fresnel);
    float variance=min(0.10,dot(width,width)*0.0001);
    float sparkle=dielectricSpecular(normal,-ray,sun_direction.xyz,0.20,variance,0.02);
    color+=float3(1.0,0.92,0.68)*sparkle*0.55;
    float seamX=periodicLine(position.x,4.0,0.018,width.x);
    float seamZ=periodicLine(position.z,4.0,0.018,width.y);
    color+=float3(0.015,0.035,0.04)*(seamX+seamZ-seamX*seamZ);
    color*=0.42+0.58*camera_up.w;
    return mix(color,skyColor(ray),min(0.85,1.0-exp(-distance*0.0035)));
}
