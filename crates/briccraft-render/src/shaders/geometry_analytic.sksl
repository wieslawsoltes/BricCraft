float2 boxInterval(float3 ro, float3 rd, float3 lower, float3 upper) {
    float3 inv = safeInverse(rd);
    float3 a = (lower-ro)*inv;
    float3 b = (upper-ro)*inv;
    float3 near = min(a,b);
    float3 far = max(a,b);
    return float2(max(max(near.x,near.y),near.z), min(min(far.x,far.y),far.z));
}

float boxHit(float3 ro, float3 rd, float3 lower, float3 upper, out float3 normal) {
    float2 interval = boxInterval(ro,rd,lower,upper);
    normal = float3(0.0,1.0,0.0);
    if (interval.x > interval.y || interval.y < 0.0) return FAR;
    float t = interval.x > 0.0001 ? interval.x : interval.y;
    float3 p = ro+rd*t;
    float3 q = (p-(lower+upper)*0.5) / max((upper-lower)*0.5, float3(0.001));
    float3 aq = abs(q);
    if (aq.x > aq.y && aq.x > aq.z) normal = float3(sign(q.x),0.0,0.0);
    else if (aq.y > aq.z) normal = float3(0.0,sign(q.y),0.0);
    else normal = float3(0.0,0.0,sign(q.z));
    return t;
}

float cylinderHit(float3 ro, float3 rd, float2 center, float bottom, float top,
    float radius, out float3 normal) {
    float2 q = ro.xz-center;
    float a = dot(rd.xz,rd.xz);
    float b = dot(q,rd.xz);
    float c = dot(q,q)-radius*radius;
    float discriminant = b*b-a*c;
    float result = FAR;
    normal = float3(0.0,1.0,0.0);
    if (a > 0.000001 && discriminant >= 0.0) {
        float root = sqrt(discriminant);
        float t = (-b-root)/a;
        if (t < 0.0001) t = (-b+root)/a;
        float y = ro.y+rd.y*t;
        if (t > 0.0001 && y >= bottom && y <= top) {
            result = t;
            normal = normalize(float3(ro.x+rd.x*t-center.x,0.0,ro.z+rd.z*t-center.y));
        }
    }
    if (abs(rd.y) > 0.000001) {
        float y = rd.y < 0.0 ? top : bottom;
        float t = (y-ro.y)/rd.y;
        float2 p = ro.xz+rd.xz*t-center;
        if (t > 0.0001 && t < result && dot(p,p) <= radius*radius) {
            result=t; normal=float3(0.0,rd.y<0.0?1.0:-1.0,0.0);
        }
    }
    return result;
}


// Analytic lower-cost geometry. Every accepted surface is solved directly:
// no nested distance-field march or sixfold finite-difference normal.
void nearer(float t,float3 candidateNormal,inout float best,inout float3 normal) {
    if(t>0.0001 && t<best) { best=t;normal=candidateNormal; }
}

float3 canonical(float3 p,float rotation) {
    if(rotation<0.5) return p;
    if(rotation<1.5) return float3(-p.z,p.y,p.x);
    if(rotation<2.5) return float3(-p.x,p.y,-p.z);
    return float3(p.z,p.y,-p.x);
}

float3 fromCanonical(float3 p,float rotation) {
    if(rotation<0.5) return p;
    if(rotation<1.5) return float3(p.z,p.y,-p.x);
    if(rotation<2.5) return float3(-p.x,p.y,-p.z);
    return float3(-p.z,p.y,p.x);
}

float2 rotatePlane(float2 p,float angle) {
    float s=sin(angle),c=cos(angle);
    return float2(c*p.x-s*p.y,s*p.x+c*p.y);
}

float3 boxNormal(float3 p,float3 extent) {
    float3 q=p/max(extent,float3(0.001)),a=abs(q);
    if(a.x>a.y && a.x>a.z) return float3(sign(q.x),0.0,0.0);
    if(a.y>a.z) return float3(0.0,sign(q.y),0.0);
    return float3(0.0,0.0,sign(q.z));
}

void addBox(float3 ro,float3 rd,float3 center,float3 extent,inout float best,inout float3 normal) {
    if(any(lessThanEqual(extent,float3(0.0)))) return;
    float3 n;
    float t=boxHit(ro,rd,center-extent,center+extent,n);
    nearer(t,n,best,normal);
}

void clipPlane(float3 ro,float3 rd,float3 n,float limit,
    inout float nearT,inout float farT,inout float3 nearNormal,inout float3 farNormal) {
    float distance=dot(n,ro)-limit,denominator=dot(n,rd);
    if(abs(denominator)<0.000001) {
        if(distance>0.0) { nearT=FAR;farT=-FAR; }
        return;
    }
    float t=-distance/denominator;
    if(denominator<0.0 && t>nearT) { nearT=t;nearNormal=normalize(n); }
    if(denominator>0.0 && t<farT) { farT=t;farNormal=normalize(n); }
}

float clippedBrick(float3 ro,float3 rd,float3 extent,float3 size,bool wing,out float3 normal) {
    float2 interval=boxInterval(ro,rd,-extent,extent);
    normal=float3(0.0,1.0,0.0);
    if(interval.x>interval.y || interval.y<0.0001) return FAR;
    float nearT=interval.x,farT=interval.y;
    float3 nearNormal=boxNormal(ro+rd*nearT,extent),farNormal=boxNormal(ro+rd*farT,extent);
    if(wing) {
        float taper=extent.x*0.25/max(extent.z,0.01);
        clipPlane(ro,rd,float3(1.0,0.0,taper),extent.x*0.72,nearT,farT,nearNormal,farNormal);
        clipPlane(ro,rd,float3(-1.0,0.0,taper),extent.x*0.72,nearT,farT,nearNormal,farNormal);
    } else {
        clipPlane(ro,rd,float3(0.0,1.0,size.y/max(size.z,0.01)),0.0,nearT,farT,nearNormal,farNormal);
    }
    if(nearT>farT || farT<0.0001) return FAR;
    normal=nearT>0.0001?nearNormal:farNormal;
    return nearT>0.0001?nearT:farT;
}

void cylinderWall(float3 ro,float3 rd,float t,float radius,float halfHeight,float signNormal,
    inout float best,inout float3 normal) {
    float3 p=ro+rd*t;
    if(abs(p.y)<=halfHeight) nearer(t,float3(p.x,0.0,p.z)/max(radius,0.001)*signNormal,best,normal);
}

void cylinderSides(float3 ro,float3 rd,float radius,float halfHeight,float signNormal,
    inout float best,inout float3 normal) {
    float a=dot(rd.xz,rd.xz),b=dot(ro.xz,rd.xz),c=dot(ro.xz,ro.xz)-radius*radius;
    float d=b*b-a*c;
    if(a>0.000001 && d>=0.0) {
        float root=sqrt(d);
        cylinderWall(ro,rd,(-b-root)/a,radius,halfHeight,signNormal,best,normal);
        cylinderWall(ro,rd,(-b+root)/a,radius,halfHeight,signNormal,best,normal);
    }
}

// A true finite annulus: side walls, both cap rings, and an open axial bore.
float annularCylinder(float3 ro,float3 rd,float outerRadius,float innerRadius,float halfHeight,out float3 normal) {
    float best=FAR;
    normal=float3(0.0,1.0,0.0);
    cylinderSides(ro,rd,outerRadius,halfHeight,1.0,best,normal);
    if(innerRadius>0.0) cylinderSides(ro,rd,innerRadius,halfHeight,-1.0,best,normal);
    if(abs(rd.y)>0.000001) {
        float t=(halfHeight-ro.y)/rd.y;
        float2 p=ro.xz+rd.xz*t;
        float r=dot(p,p);
        if(r>=innerRadius*innerRadius && r<=outerRadius*outerRadius)
            nearer(t,float3(0.0,1.0,0.0),best,normal);
        t=(-halfHeight-ro.y)/rd.y;p=ro.xz+rd.xz*t;r=dot(p,p);
        if(r>=innerRadius*innerRadius && r<=outerRadius*outerRadius)
            nearer(t,float3(0.0,-1.0,0.0),best,normal);
    }
    return best;
}

float beamHit(float3 ro,float3 rd,float3 extent,float3 size,out float3 normal) {
    float2 interval=boxInterval(ro,rd,-extent,extent);
    float best=boxHit(ro,rd,-extent,extent,normal);
    if(best>=FAR) return FAR;
    float3 p=ro+rd*best;
    float holeX=floor(p.x+size.x*0.5)+0.5-size.x*0.5;
    float2 q=float2(p.x-holeX,p.y);
    if(dot(q,q)>=0.22*0.22) return best;
    // The incoming cap lies in a pin hole. Solve its inner wall analytically;
    // an axis-aligned sightline through the hole correctly misses the beam.
    q=float2(ro.x-holeX,ro.y);
    float a=dot(rd.xy,rd.xy),b=dot(q,rd.xy),c=dot(q,q)-0.22*0.22;
    float d=b*b-a*c;
    if(a<=0.000001 || d<0.0) return FAR;
    float t=(-b+sqrt(d))/a;
    if(t<max(interval.x,0.0001) || t>interval.y) return FAR;
    p=ro+rd*t;
    normal=-normalize(float3(p.x-holeX,p.y,0.0));
    return t;
}

float frameHit(float3 ro,float3 rd,float3 extent,float3 size,bool window,out float3 normal) {
    float best=FAR;
    normal=float3(0.0,1.0,0.0);
    float holeX=window?max(extent.x-0.19,0.04):extent.x*0.64;
    float holeY=window?max(extent.y-0.21,0.04):extent.y*0.48;
    float centerY=window?0.0:size.y*0.17;
    float side=(extent.x-holeX)*0.5;
    addBox(ro,rd,float3((extent.x+holeX)*0.5,0.0,0.0),float3(side,extent.y,extent.z),best,normal);
    addBox(ro,rd,float3(-(extent.x+holeX)*0.5,0.0,0.0),float3(side,extent.y,extent.z),best,normal);
    addBox(ro,rd,float3(0.0,(extent.y+centerY+holeY)*0.5,0.0),
        float3(holeX,(extent.y-centerY-holeY)*0.5,extent.z),best,normal);
    addBox(ro,rd,float3(0.0,(-extent.y+centerY-holeY)*0.5,0.0),
        float3(holeX,(extent.y+centerY-holeY)*0.5,extent.z),best,normal);
    if(window) {
        addBox(ro,rd,float3(0.0),float3(0.065,extent.y,extent.z),best,normal);
        addBox(ro,rd,float3(0.0),float3(extent.x,0.055,extent.z),best,normal);
    }
    return best;
}

void coneSide(float3 ro,float3 rd,float t,float3 extent,float tip,float slope,
    inout float best,inout float3 normal) {
    float3 p=ro+rd*t;
    if(abs(p.y)<=extent.y && p.y<=tip)
        nearer(t,normalize(float3(p.x,slope*slope*(tip-p.y),p.z)),best,normal);
}

float coneHit(float3 ro,float3 rd,float3 extent,float3 size,out float3 normal) {
    float best=FAR;
    normal=float3(0.0,1.0,0.0);
    float tip=size.y*0.5,slope=min(extent.x,extent.z)/max(size.y,0.01),k=slope*slope;
    float a=dot(rd.xz,rd.xz)-k*rd.y*rd.y;
    float b=dot(ro.xz,rd.xz)+k*(tip-ro.y)*rd.y;
    float c=dot(ro.xz,ro.xz)-k*(tip-ro.y)*(tip-ro.y);
    float d=b*b-a*c;
    if(abs(a)>0.000001) {
        if(d>=0.0) {
            float root=sqrt(d);
            coneSide(ro,rd,(-b-root)/a,extent,tip,slope,best,normal);
            coneSide(ro,rd,(-b+root)/a,extent,tip,slope,best,normal);
        }
    } else if(abs(b)>0.000001) coneSide(ro,rd,-c/(2.0*b),extent,tip,slope,best,normal);
    if(abs(rd.y)>0.000001) {
        float t=(-extent.y-ro.y)/rd.y,r=slope*(tip+extent.y);
        if(dot(ro.xz+rd.xz*t,ro.xz+rd.xz*t)<=r*r) nearer(t,float3(0.0,-1.0,0.0),best,normal);
        t=(extent.y-ro.y)/rd.y;r=slope*(tip-extent.y);
        if(dot(ro.xz+rd.xz*t,ro.xz+rd.xz*t)<=r*r) nearer(t,float3(0.0,1.0,0.0),best,normal);
    }
    return best;
}

void archArc(float3 ro,float3 rd,float t,float radius,float centerY,float2 interval,
    inout float best,inout float3 normal) {
    float3 p=ro+rd*t;
    if(t>=max(interval.x,0.0001) && t<=interval.y && p.y>=centerY)
        nearer(t,-float3(p.x,p.y-centerY,0.0)/radius,best,normal);
}

float archHit(float3 ro,float3 rd,float3 extent,float3 size,out float3 normal) {
    float2 interval=boxInterval(ro,rd,-extent,extent);
    float t=boxHit(ro,rd,-extent,extent,normal);
    if(t>=FAR) return FAR;
    float centerY=-size.y*0.23,radius=extent.x*0.70;
    float3 p=ro+rd*t;
    float2 q=float2(p.x,max(p.y-centerY,0.0));
    if(dot(q,q)>=radius*radius) return t;
    float best=FAR;
    q=float2(ro.x,ro.y-centerY);
    float a=dot(rd.xy,rd.xy),b=dot(q,rd.xy),c=dot(q,q)-radius*radius,d=b*b-a*c;
    if(a>0.000001 && d>=0.0) {
        float root=sqrt(d);
        archArc(ro,rd,(-b-root)/a,radius,centerY,interval,best,normal);
        archArc(ro,rd,(-b+root)/a,radius,centerY,interval,best,normal);
    }
    if(abs(rd.x)>0.000001) {
        t=(radius-ro.x)/rd.x;p=ro+rd*t;
        if(t>=max(interval.x,0.0001) && t<=interval.y && p.y<=centerY)
            nearer(t,float3(-1.0,0.0,0.0),best,normal);
        t=(-radius-ro.x)/rd.x;p=ro+rd*t;
        if(t>=max(interval.x,0.0001) && t<=interval.y && p.y<=centerY)
            nearer(t,float3(1.0,0.0,0.0),best,normal);
    }
    return best;
}

float analyticPart(float3 ro,float3 rd,PartData part,out float3 normal) {
    float3 q=canonical(ro-part.origin-part.size*0.5,part.rotation);
    float3 d=canonical(rd,part.rotation),size=part.size;
    if(mod(part.rotation,2.0)>0.5) size=size.zyx;
    float kind=part.shape,best=FAR;
    int axisSwap=0;
    // The catalog includes both X-long and Z-long beams and architecture.
    // Solve their holes along the actual narrow axis, not an assumed Z face.
    bool wideFace=(kind>7.5 && kind<10.5) || (kind>13.5 && kind<14.5);
    if(wideFace && size.z>size.x) {
        q=q.zyx;d=d.zyx;size=size.zyx;axisSwap=1;
    } else if(kind>14.5) {
        // A propeller rotates in its two wide dimensions. Aircraft propellers
        // are thin in X; helicopter rotors and foliage are thin in Y.
        if(size.x<size.y && size.x<=size.z) {
            q=q.yxz;d=d.yxz;size=size.yxz;axisSwap=2;
        } else if(size.z<size.y && size.z<size.x) {
            q=q.xzy;d=d.xzy;size=size.xzy;axisSwap=3;
        }
    }
    float3 extent=max(size*0.5-float3(0.018),float3(0.01));
    normal=float3(0.0,1.0,0.0);
    bool spinningAxle=part.moving>0.5 && kind>6.5 && kind<7.5;
    bool spinningRotor=part.moving>0.5 && kind>14.5;
    if(spinningAxle) {
        if(size.x>=size.z) { q.yz=rotatePlane(q.yz,vehicle_motion.x);d.yz=rotatePlane(d.yz,vehicle_motion.x); }
        else { q.xy=rotatePlane(q.xy,vehicle_motion.x);d.xy=rotatePlane(d.xy,vehicle_motion.x); }
    }
    if(spinningRotor) { q.xz=rotatePlane(q.xz,vehicle_motion.y);d.xz=rotatePlane(d.xz,vehicle_motion.y); }
    if(kind<3.5) best=clippedBrick(q,d,extent,size,false,normal);
    else if(kind<4.5) best=annularCylinder(q,d,min(extent.x,extent.z),0.0,extent.y,normal);
    else if(kind<6.5) {
        float3 n;
        float radius=min(extent.y,extent.z);
        best=annularCylinder(q.yxz,d.yxz,radius,kind<5.5?radius*0.20:0.13,extent.x,n);
        normal=n.yxz;
    } else if(kind<7.5) {
        if(size.x>=size.z) {
            float scale=min(1.0,min(extent.y,extent.z)/0.232595);
            addBox(q,d,float3(0.0),float3(extent.x,0.10*scale,0.21*scale),best,normal);
            addBox(q,d,float3(0.0),float3(extent.x,0.21*scale,0.10*scale),best,normal);
        } else {
            float scale=min(1.0,min(extent.x,extent.y)/0.232595);
            addBox(q,d,float3(0.0),float3(0.10*scale,0.21*scale,extent.z),best,normal);
            addBox(q,d,float3(0.0),float3(0.21*scale,0.10*scale,extent.z),best,normal);
        }
    } else if(kind<8.5) best=beamHit(q,d,extent,size,normal);
    else if(kind<10.5) best=frameHit(q,d,extent,size,kind<9.5,normal);
    else if(kind<11.5) {
        addBox(q,d,float3(size.x*0.29,0.0,0.0),float3(0.10,extent.y,extent.z),best,normal);
        addBox(q,d,float3(-size.x*0.29,0.0,0.0),float3(0.10,extent.y,extent.z),best,normal);
        // A sleeper strip is a distant-detail simplification; the two open
        // parallel rails retain their independent silhouettes.
        addBox(q,d,float3(0.0,-extent.y*0.48,0.0),float3(extent.x,extent.y*0.5,extent.z),best,normal);
    } else if(kind<12.5) best=clippedBrick(q,d,extent,size,true,normal);
    else if(kind<13.5) best=coneHit(q,d,extent,size,normal);
    else if(kind<14.5) best=archHit(q,d,extent,size,normal);
    else {
        float radius=min(extent.x,extent.z),width=min(0.20,radius*0.30);
        float length=sqrt(max(radius*radius-width*width,0.000001));
        addBox(q,d,float3(0.0),float3(length,extent.y,width),best,normal);
        addBox(q,d,float3(0.0),float3(width,extent.y,length),best,normal);
    }
    if(spinningAxle) {
        if(size.x>=size.z) normal.yz=rotatePlane(normal.yz,-vehicle_motion.x);
        else normal.xy=rotatePlane(normal.xy,-vehicle_motion.x);
    }
    if(spinningRotor) normal.xz=rotatePlane(normal.xz,-vehicle_motion.y);
    if(axisSwap==1) normal=normal.zyx;
    else if(axisSwap==2) normal=normal.yxz;
    else if(axisSwap==3) normal=normal.xzy;
    normal=fromCanonical(normal,part.rotation);
    return best;
}
bool hasStuds(float shape) {
    return shape<1.5 || abs(shape-4.0)<0.1 || abs(shape-9.0)<0.1
        || abs(shape-10.0)<0.1 || abs(shape-14.0)<0.1;
}

float studHit(float3 ro,float3 rd,PartData part,float3 cell,out float3 normal) {
    normal=float3(0.0,1.0,0.0);
    if(!hasStuds(part.shape)) return FAR;
    float2 center=floor(cell.xz-part.origin.xz)+part.origin.xz+float2(0.5);
    if(any(lessThanEqual(center,part.origin.xz)) || any(greaterThanEqual(center,part.origin.xz+part.size.xz))) return FAR;
    return cylinderHit(ro,rd,center,part.origin.y+part.size.y-0.025,
        part.origin.y+part.size.y+STUD_HEIGHT,0.30,normal);
}

Hit partSurface(float3 ro,float3 rd,float id,PartData part,float t,float3 normal) {
    Hit hit=miss();
    hit.t=t;hit.normal=normal;hit.id=id;hit.shape=part.shape;hit.rotation=part.rotation;
    // Descriptor colors are needed only for an accepted hit, never while
    // searching empty portions of a shaped part or a stud's bounding cell.
    hit.albedo=record(id,2.0)/255.0;
    hit.local=ro+rd*t-part.origin;hit.size=part.size;
    return hit;
}

Hit intersectStud(float3 ro,float3 rd,float id,float3 cell,float entry,float exit) {
    PartData part=readPart(id);
    if(abs(part.origin.y+part.size.y-cell.y*PLATE)>0.02) return miss();
    float3 normal;
    float t=studHit(ro,rd,part,cell,normal);
    if(t>=entry-0.004 && t<=exit+0.005) return partSurface(ro,rd,id,part,t,normal);
    return miss();
}


Hit intersectPart(float3 ro,float3 rd,float id,float3 cell,float entry,float exit) {
    PartData p=readPart(id);
    float3 normal=float3(0.0,1.0,0.0);
    float t=FAR;
    if(p.shape<2.5) {
        t=boxHit(ro,rd,p.origin+float3(0.012,0.0,0.012),
            p.origin+p.size-float3(0.012,0.004,0.012),normal);
    } else t=analyticPart(ro,rd,p,normal);
    float3 studNormal;
    float stud=studHit(ro,rd,p,cell,studNormal);
    if(stud<t) { t=stud;normal=studNormal; }
    if(t>=entry-0.004 && t<=exit+0.005) return partSurface(ro,rd,id,p,t,normal);
    return miss();
}
