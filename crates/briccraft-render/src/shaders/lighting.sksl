float3 shadeBrick(Hit hit,float3 position,float3 ray) {
    float3 width=surfaceFootprint(hit.t,ray,hit.normal,hit.moving);
    float variance;
    float3 normal=moldedNormal(hit,width,variance);
    if(hit.moving>0.5) normal=normalize(vehicle_axis_x.xyz*normal.x+vehicle_axis_y.xyz*normal.y+vehicle_axis_z.xyz*normal.z);
    float3 light=sun_direction.xyz;
    float daylight=camera_up.w;
    float roughness;
    float3 base=partAlbedo(hit,width,roughness);
    float ao=ambientOcclusion(position,normal);
    float shadow=sunlight(position+normal*0.04,light,hit.id);
    if(hasStuds(hit.shape) && hit.local.y<hit.size.y+0.02 && hit.normal.y>0.5) {
        float3 localLight=hit.moving>0.5?vehicleDirection(light):light;
        shadow*=studContactShadow(hit,localLight,width);
        float radial=length(fract(hit.local.xz)-float2(0.5));
        float contactDetail=1.0-smoothstep(0.25,1.2,length(width.xz));
        ao*=1.0-0.20*exp(-max(radial-0.30,0.0)*20.0)*contactDetail;
    }
    float diffuse=max(dot(normal,light),0.0)*shadow;
    float sky=0.5+0.5*normal.y;
    float3 ambient=mix(float3(0.16,0.18,0.23),float3(0.42,0.53,0.63),sky)*ao;
    ambient*=0.30+0.70*daylight;
    float3 sunlightColor=mix(float3(0.40,0.54,0.82),float3(1.0,0.92,0.76),daylight);
    float3 color=base*(ambient+sunlightColor*diffuse*(0.32+0.63*daylight));
    if(hit.shape<2.5 && abs(hit.normal.y)<0.5) {
        float seam=intervalCoverage(hit.local.y,0.0,0.04,width.y)
            +intervalCoverage(hit.local.y,hit.size.y-0.04,hit.size.y,width.y);
        color*=1.0-min(seam,1.0)*0.27;
    }
    float specular=dielectricSpecular(normal,-ray,light,roughness,variance,0.035);
    color+=sunlightColor*specular*shadow*(0.45+daylight*0.55);
    float fresnel=0.035+0.965*pow5(1.0-max(dot(-ray,normal),0.0));
    float environmentWeight=fresnel*(0.36-roughness*0.14);
    color=mix(color,skyEnvironment(reflect(ray,normal)),environmentWeight);
    if(hit.local.y>hit.size.y+STUD_HEIGHT-0.025 && hasStuds(hit.shape)) {
        float2 radial=fract(hit.local.xz)-float2(0.5);
        float ring=intervalCoverage(length(radial),0.228,0.251,radialFootprint(radial,width.xz));
        color*=1.0-ring*0.075;
    }
    if(hit.id==float(selection)) {
        float3 edge=min(hit.local,hit.size-hit.local);
        float edgeWidth=max(0.025,pixelSpread()*hit.t*0.70);
        float outline=0.13+0.77*cornerCoverage(edge,width,edgeWidth);
        color=mix(color,float3(1.0,0.79,0.32),outline);
    }
    float fog=(1.0-exp(-hit.t*hit.t*0.000026))*0.75;
    if(hit.moving<0.5 && camera_right.w>0.0) {
        fog=max(fog,windowBoundaryFog(position.xz));
    }
    return mix(color,skyColor(ray),fog);
}
