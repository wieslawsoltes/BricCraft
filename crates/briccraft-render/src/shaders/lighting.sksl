float hash21(float2 p) { return fract(sin(dot(p,float2(127.1,311.7)))*43758.5453); }

float noise2(float2 p) {
    float2 i=floor(p);float2 f=fract(p);f=f*f*(3.0-2.0*f);
    return mix(mix(hash21(i),hash21(i+float2(1.0,0.0)),f.x),
        mix(hash21(i+float2(0.0,1.0)),hash21(i+float2(1.0,1.0)),f.x),f.y);
}

float3 skyColor(float3 ray) {
    float daylight=camera_up.w;
    float height=clamp(ray.y*0.75+0.20,0.0,1.0);
    float3 horizon=mix(float3(0.08,0.13,0.22),float3(0.77,0.90,0.95),daylight);
    float3 zenith=mix(float3(0.015,0.035,0.09),float3(0.26,0.62,0.84),daylight);
    float3 color=mix(horizon,zenith,sqrt(height));
    float sun=max(dot(ray,sun_direction.xyz),0.0);
    color+=float3(1.0,0.81,0.47)*pow(sun,32.0)*0.15*daylight;
    color+=float3(1.0,0.96,0.82)*smoothstep(0.9985,0.9996,sun)*daylight;
    if(ray.y>0.02) {
        float2 uv=ray.xz/max(ray.y,0.08)*1.1+float2(camera_position.w*0.003,0.0);
        float clouds=noise2(uv)*0.65+noise2(uv*2.07)*0.25+noise2(uv*4.0)*0.10;
        float density=smoothstep(0.56,0.75,clouds)*smoothstep(0.02,0.25,ray.y);
        color=mix(color,mix(float3(0.18,0.22,0.32),float3(1.0,0.98,0.91),daylight),density*0.76);
    }
    return color;
}

float3 moldedNormal(Hit h) {
    float3 normal=h.normal;
    if(h.shape<2.5) {
        if(h.local.y>h.size.y-0.005) {
            float2 radial=fract(h.local.xz)-float2(0.5);
            float radius=length(radial);
            float cap=abs(h.local.y-h.size.y-STUD_HEIGHT);
            if(radius>0.26 && cap<0.045 && radius<0.34) {
                float3 ring=normalize(float3(radial.x*5.0,1.0,radial.y*5.0));
                normal=normalize(mix(normal,ring,0.7));
            }
        } else {
            float3 edge=min(h.local,h.size-h.local);
            float3 side=sign(h.local-h.size*0.5);
            float3 bevel=(float3(1.0)-smoothstep(float3(0.015),float3(0.065),edge))*side;
            if(dot(bevel,bevel)>0.01) normal=normalize(normal+bevel*0.30);
        }
    }
    return normal;
}

float3 shadeBrick(Hit hit,float3 position,float3 ray) {
    float3 normal=moldedNormal(hit);
    if(hit.moving>0.5) normal=normalize(vehicle_axis_x.xyz*normal.x+vehicle_axis_y.xyz*normal.y+vehicle_axis_z.xyz*normal.z);
    float3 light=sun_direction.xyz;
    float daylight=camera_up.w;
    float3 base=hit.albedo;
    if(abs(hit.shape-5.0)<0.1) {
        float3 q=hit.local-hit.size*0.5;
        float radial=length(q.yz)/max(min(hit.size.y,hit.size.z)*0.5,0.01);
        base=mix(float3(0.64,0.68,0.71),float3(0.045,0.055,0.067),smoothstep(0.46,0.60,radial));
        base*=0.91+0.09*step(0.0,sin((atan(q.z,q.y)+hit.moving*vehicle_motion.x)*36.0));
    }
    float ao=ambientOcclusion(position,normal);
    float shadow=sunlight(position+normal*0.04,light,hit.id);
    if(hit.shape<1.5 && hit.local.y<hit.size.y+0.02 && hit.normal.y>0.5) {
        float3 localLight=hit.moving>0.5?vehicleDirection(light):light;
        float2 center=floor(hit.local.xz+localLight.xz/max(localLight.y,0.1)*STUD_HEIGHT*0.5)+float2(0.5);
        float3 ignoredNormal;
        if(all(greaterThan(center,float2(0.0))) && all(lessThan(center,hit.size.xz))) {
            float studShadow=cylinderHit(hit.local+float3(0.0,0.02,0.0),localLight,center,
                hit.size.y-0.025,hit.size.y+STUD_HEIGHT,0.30,ignoredNormal);
            if(studShadow<0.75) shadow*=0.43;
        }
        float radial=length(fract(hit.local.xz)-float2(0.5));
        ao*=1.0-0.20*exp(-max(radial-0.30,0.0)*20.0);
    }
    float diffuse=max(dot(normal,light),0.0)*shadow;
    float sky=0.5+0.5*normal.y;
    float3 ambient=mix(float3(0.12,0.16,0.23),float3(0.42,0.52,0.60),sky)*ao;
    ambient*=0.35+0.65*daylight;
    float3 color=base*(ambient+float3(1.0,0.91,0.73)*diffuse*(0.38+0.57*daylight));
    if(hit.shape<2.5 && abs(hit.normal.y)<0.5) {
        float seam=min(hit.local.y,hit.size.y-hit.local.y);
        color*=mix(0.73,1.0,smoothstep(0.0,0.04,seam));
    }
    // Dielectric clear plastic: small white highlight, broad soft lobe,
    // and a restrained Fresnel reflection of the environment.
    float3 halfway=normalize(light-ray);
    float ndh=max(dot(normal,halfway),0.0);
    float specular=pow(ndh,82.0)*0.30+pow(ndh,13.0)*0.045;
    color+=float3(1.0,0.96,0.86)*specular*shadow*(0.5+daylight*0.5);
    float fresnel=0.025+0.12*pow(1.0-max(dot(-ray,normal),0.0),4.0);
    color=mix(color,skyColor(reflect(ray,normal)),fresnel);
    if(hit.local.y>hit.size.y+STUD_HEIGHT-0.025 && hit.shape<1.5) {
        float radius=length(fract(hit.local.xz)-float2(0.5));
        float ring=smoothstep(0.21,0.235,radius)*(1.0-smoothstep(0.245,0.26,radius));
        color*=1.0-ring*0.075;
    }
    if(hit.id==float(selection)) {
        float3 edge=min(hit.local,hit.size-hit.local);
        float edgeWidth=max(0.035,hit.t*0.0005);
        float edgeCount=(edge.x<edgeWidth?1.0:0.0)+(edge.y<edgeWidth?1.0:0.0)+(edge.z<edgeWidth?1.0:0.0);
        float outline=edgeCount>1.5?0.90:0.13;
        color=mix(color,float3(1.0,0.79,0.32),outline);
    }
    float fog=1.0-exp(-hit.t*hit.t*0.000026);
    return mix(color,skyColor(ray),fog*0.75);
}

float3 waterColor(float3 position,float3 ray,float distance) {
    float time=camera_position.w;
    float2 uv=position.xz;
    float wave1=sin(uv.x*0.46+uv.y*0.29+time*1.3);
    float wave2=sin(uv.x*0.19-uv.y*0.48-time*0.8);
    float3 normal=normalize(float3(wave1*0.055,1.0,wave2*0.055));
    float fresnel=0.12+0.68*pow(1.0-max(dot(-ray,normal),0.0),4.0);
    float3 color=mix(float3(0.035,0.47,0.58),skyColor(reflect(ray,normal)),fresnel);
    float sparkle=pow(max(dot(normal,normalize(sun_direction.xyz-ray)),0.0),140.0);
    color+=float3(1.0,0.92,0.68)*sparkle*0.55;
    float tile=abs(fract(position.x*0.25)-0.5)+abs(fract(position.z*0.25)-0.5);
    color+=float3(0.015,0.035,0.04)*smoothstep(0.94,0.995,tile);
    color*=0.42+0.58*camera_up.w;
    return mix(color,skyColor(ray),min(0.85,1.0-exp(-distance*0.0035)));
}
